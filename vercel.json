{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p dist && cp -R front-end/. dist/ && cp -R assets dist/assets",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://replace-with-your-app.azurewebsites.net/api/:path*"
    }
  ]
}
